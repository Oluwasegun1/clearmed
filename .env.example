# Pooled connection (Supabase "Transaction pooler", port 6543) used by the app at runtime.
# Must include ?pgbouncer=true&connection_limit=1 for serverless/Vercel.
DATABASE_URL=
# Direct connection (Supabase "Direct"/"Session pooler", port 5432) used by prisma migrate.
DIRECT_URL=
# Public URL of the deployment, e.g. your Vercel domain. Local: http://localhost:3001
NEXTAUTH_URL=
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Field-level encryption key (AES-256-GCM). Generate with: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=
# Must be false in production
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=false
